# Значения по умолчанию для docker-compose. Локальные правки кладутся в .env, он в git не попадает.

# ===== SERVICE CONFIG =====
SERVICE_NAME=payments-processing
LOG_LEVEL=INFO
LOG_JSON=true

# ===== API CONFIG =====
UVICORN__HOST=0.0.0.0
UVICORN__PORT=8000
API__DOCS_ENABLED=true
# Ключ для локального запуска. На боевом контуре задаётся секретом.
AUTH__API_KEY=local-api-key

# ===== DB CONFIG =====
DB__URL=postgresql+asyncpg://postgres:pass@db:5432/payments

# ===== RABBIT CONFIG =====
RABBIT__URL=amqp://guest:guest@rabbitmq:5672/
RABBIT__MAX_ATTEMPTS=3
RABBIT__RETRY_BASE_DELAY_SEC=2
RABBIT__PREFETCH_COUNT=10
RABBIT__GRACEFUL_TIMEOUT_SEC=15

# ===== OUTBOX CONFIG =====
OUTBOX__BATCH_SIZE=100
OUTBOX__POLL_INTERVAL_SEC=0.5
OUTBOX__MAX_ERROR_DELAY_SEC=10
OUTBOX__RETENTION_DAYS=7

# ===== GATEWAY EMULATION CONFIG =====
GATEWAY__MIN_DELAY_SEC=2
GATEWAY__MAX_DELAY_SEC=5
GATEWAY__SUCCESS_RATE=0.9

# ===== WEBHOOK CONFIG =====
WEBHOOK__TIMEOUT_SEC=5
# Если задан, вебхуки подписываются по Standard Webhooks (заголовок webhook-signature).
# Формат whsec_<base64 от 24–64 случайных байт>.
WEBHOOK__SECRET=

# ===== METRICS AND HEALTH CONFIG =====
METRICS__ENABLED=true
METRICS__PORT=9000
HEARTBEAT__PATH=/tmp/payments-heartbeat
