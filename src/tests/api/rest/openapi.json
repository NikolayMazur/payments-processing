{
  "components": {
    "schemas": {
      "CreatePaymentOutputDTO": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "payment_id": {
            "format": "uuid",
            "title": "Payment Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatusEnum"
          }
        },
        "required": [
          "payment_id",
          "status",
          "created_at"
        ],
        "title": "CreatePaymentOutputDTO",
        "type": "object"
      },
      "CreatePaymentRequestSchema": {
        "properties": {
          "amount": {
            "description": "Сумма больше нуля, не более двух знаков после запятой",
            "examples": [
              "1500.00"
            ],
            "pattern": "^(?!0*(\\.0*)?$)[0-9]{1,16}(\\.[0-9]{1,2})?$",
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "$ref": "#/components/schemas/CurrencyEnum"
          },
          "description": {
            "default": "",
            "maxLength": 1024,
            "pattern": "^[^\\u0000]*$",
            "title": "Description",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "webhook_url": {
            "description": "Адрес http или https, на который придёт уведомление о результате",
            "examples": [
              "https://client.example.com/webhooks/payments"
            ],
            "maxLength": 2083,
            "pattern": "^https?://[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?){0,4}(:[1-9][0-9]{1,3})?(/[A-Za-z0-9._~-]{0,40}){0,5}$",
            "title": "Webhook Url",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency",
          "webhook_url"
        ],
        "title": "CreatePaymentRequestSchema",
        "type": "object"
      },
      "CurrencyEnum": {
        "enum": [
          "RUB",
          "USD",
          "EUR"
        ],
        "title": "CurrencyEnum",
        "type": "string"
      },
      "DetailErrorSchema": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorSchema"
          }
        },
        "required": [
          "detail"
        ],
        "title": "DetailErrorSchema",
        "type": "object"
      },
      "ErrorSchema": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "message_code": {
            "title": "Message Code",
            "type": "string"
          }
        },
        "required": [
          "message_code",
          "message"
        ],
        "title": "ErrorSchema",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthCheckSchema": {
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthCheckSchema",
        "type": "object"
      },
      "PaymentOutputDTO": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "$ref": "#/components/schemas/CurrencyEnum"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "payment_id": {
            "format": "uuid",
            "title": "Payment Id",
            "type": "string"
          },
          "processed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processed At"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatusEnum"
          },
          "webhook_attempts": {
            "title": "Webhook Attempts",
            "type": "integer"
          },
          "webhook_delivered_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook Delivered At"
          },
          "webhook_url": {
            "title": "Webhook Url",
            "type": "string"
          }
        },
        "required": [
          "payment_id",
          "amount",
          "currency",
          "description",
          "metadata",
          "status",
          "idempotency_key",
          "webhook_url",
          "failure_reason",
          "created_at",
          "processed_at",
          "webhook_attempts",
          "webhook_delivered_at"
        ],
        "title": "PaymentOutputDTO",
        "type": "object"
      },
      "PaymentStatusEnum": {
        "enum": [
          "pending",
          "succeeded",
          "failed"
        ],
        "title": "PaymentStatusEnum",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Асинхронный сервис процессинга платежей",
    "title": "Payments processing",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/payments": {
      "post": {
        "operationId": "create_payment_api_v1_payments_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePaymentOutputDTO"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Тело запроса не разбирается как JSON или Idempotency-Key передан несколько раз"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailErrorSchema"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailErrorSchema"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailErrorSchema"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailErrorSchema"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create Payment",
        "tags": [
          "Payments"
        ]
      }
    },
    "/api/v1/payments/{payment_id}": {
      "get": {
        "operationId": "get_payment_api_v1_payments__payment_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "payment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Payment Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentOutputDTO"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailErrorSchema"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailErrorSchema"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailErrorSchema"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Get Payment",
        "tags": [
          "Payments"
        ]
      }
    },
    "/healthcheck": {
      "get": {
        "operationId": "healthcheck_healthcheck_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailErrorSchema"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Healthcheck",
        "tags": [
          "Service"
        ]
      }
    }
  }
}
